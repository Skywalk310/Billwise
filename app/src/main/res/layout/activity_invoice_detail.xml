<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_d_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tv_d_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_d_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tv_d_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_d_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_d_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_d_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <TableLayout
            android:id="@+id/table_bill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1" />

        <TextView
            android:id="@+id/tv_d_remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_generated"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

        <!-- Single action set (v1.0.5): all 6 actions at the BOTTOM, once only.
             IDs keep the btn_top_ prefix so the activity code is unchanged. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_pdf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save_to_downloads"
            style="@style/Widget.BillWise.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edit"
            style="@style/Widget.BillWise.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_duplicate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/duplicate"
            style="@style/Widget.BillWise.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_toggle_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mark_paid"
            style="@style/Widget.BillWise.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/delete"
            style="@style/Widget.BillWise.OutlinedButton" />

        <TextView
            android:id="@+id/tv_version_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="BillWise v1.0.8"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
